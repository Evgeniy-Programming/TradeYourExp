# === Database ===
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# === JWT Secrets (минимум 32 символа, случайные!) ===
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# === Services ===
AUTH_SERVICE_ADDR=
GRPC_PORT=

# === Backend ===
# true, если приложение отдаётся по HTTPS
COOKIE_SECURE=false
# нужен только при обращении к API напрямую, в обход прокси Vite
CORS_ORIGIN=http://localhost:5173

# === Frontend ===
# куда Vite проксирует /api (в docker-compose — http://app:8080)
API_PROXY_TARGET=http://localhost:8080
# оставьте пустым: по умолчанию используется /api/v1/ через прокси
VITE_API_URL=